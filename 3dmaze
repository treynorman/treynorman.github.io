      <svg viewBox="0 0 32 32" aria-hidden="true">
        <rect x="12.5" y="4" width="7" height="3.4" rx="1.2" fill="#98a1a9" stroke="#454d55"/>
        <rect x="5" y="6.8" width="22" height="4" rx="1" fill="#b9c2ca" stroke="#454d55"/>
        <polygon points="7,10.8 25,10.8 22.7,29 9.3,29" fill="#cdd5dc" stroke="#454d55"/>
        <path d="M12.4,11.8 V28.2 M16,11.8 V29 M19.6,11.8 V28.2" stroke="#8b949c" fill="none"/>
        <g fill="#1e7c33">
          <path d="M16,13.6 L18.7,16.3 L17.3,16.3 L17.3,18.9 L14.7,18.9 L14.7,16.3 L13.3,16.3 Z"/>
          <path transform="rotate(120 16 20.6)" d="M16,13.6 L18.7,16.3 L17.3,16.3 L17.3,18.9 L14.7,18.9 L14.7,16.3 L13.3,16.3 Z"/>
          <path transform="rotate(240 16 20.6)" d="M16,13.6 L18.7,16.3 L17.3,16.3 L17.3,18.9 L14.7,18.9 L14.7,16.3 L13.3,16.3 Z"/>
        </g>
