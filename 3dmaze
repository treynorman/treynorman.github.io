<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>3D Maze — Windows 95 Screensaver</title>
<style>
:root{
  --face:#c0c0c0; --hi:#ffffff; --lo:#dfdfdf; --sh:#808080; --dk:#0a0a0a;
  --teal:#008080; --navy:#000080;
}
*{ box-sizing:border-box; }
html,body{ height:100%; }
body{
  margin:0; background:#000; overflow:hidden;
  font-family:Tahoma,"MS Sans Serif","Segoe UI",Verdana,sans-serif;
  font-size:11px; color:#000; cursor:default;
  -webkit-user-select:none; user-select:none;
}
.hidden{ display:none !important; }
button{ font-family:inherit; font-size:11px; }
.btn95{
  display:inline-flex; align-items:center; justify-content:center;
  background:var(--face); border:0; color:#000; padding:2px 0; cursor:pointer;
  box-shadow: inset -1px -1px var(--dk), inset 1px 1px var(--hi),
              inset -2px -2px var(--sh), inset 2px 2px var(--lo);
}
.btn95:active{
  box-shadow: inset -1px -1px var(--hi), inset 1px 1px var(--dk),
              inset -2px -2px var(--lo), inset 2px 2px var(--sh);
}
.btn95:focus{ outline:1px dotted #000; outline-offset:-4px; }

/* ---------------- screensaver stage ---------------- */
#stage{ position:fixed; inset:0; background:#000; }
#gl{ position:absolute; inset:0; width:100%; height:100%; display:block; cursor:none; }
#vignette{
  position:absolute; inset:0; pointer-events:none;
  background:radial-gradient(ellipse at 50% 46%, rgba(0,0,0,0) 52%, rgba(0,0,0,.38) 100%);
}
#fade{ position:absolute; inset:0; background:#000; opacity:0; pointer-events:none; transition:opacity .5s ease; }
#hint{
  position:absolute; top:10px; left:12px; z-index:7; pointer-events:none;
  background:rgba(14,11,8,.62); border:1px solid #000; color:#cfc8ba;
  padding:7px 11px; line-height:1.7; transition:opacity .9s ease; max-width:360px;
}
#hint b{ color:#fff; }
#hint.hide{ opacity:0; }
#pausedChip{
  position:absolute; left:12px; bottom:48px; z-index:7;
  background:var(--face); color:#000; font-weight:bold; padding:3px 10px;
  box-shadow: inset -1px -1px var(--dk), inset 1px 1px var(--hi),
              inset -2px -2px var(--sh), inset 2px 2px var(--lo);
}

/* caption bar (the classic screensaver nameplate) */
#caption{
  position:absolute; left:0; right:0; bottom:0; height:34px; z-index:8;
  background:var(--face); display:flex; align-items:center; gap:8px; padding:0 6px;
  box-shadow: inset 0 1px 0 var(--hi), inset 0 2px 0 var(--lo);
}
#caption .cap-ico{ width:16px; height:16px; flex:0 0 auto; }
#caption .cap-title{ font-weight:bold; }
.cap-spacer{ flex:1; }
.status-field{
  background:#fff; color:#111; min-width:56px; text-align:center; padding:1px 8px;
  box-shadow: inset 1px 1px 0 var(--sh), inset 2px 2px 0 var(--lo), inset -1px -1px 0 var(--hi);
}
#capClose{ width:26px; height:22px; font-size:13px; font-weight:bold; }

/* ---------------- desktop ---------------- */
#desktop{ position:fixed; inset:0; background:var(--teal); z-index:20; }
#icons{ position:absolute; top:18px; left:16px; display:flex; flex-direction:column; gap:14px; }
.icon{ width:82px; text-align:center; cursor:pointer; }
.icon svg{ width:32px; height:32px; display:inline-block; }
.icon .label{
  display:inline-block; margin-top:4px; color:#fff; padding:0 3px;
  text-shadow:1px 1px 0 rgba(0,0,0,.75);
}
.icon.sel svg{ outline:1px dotted #fff; }
.icon.sel .label{ background:var(--navy); outline:1px dotted #fff; text-shadow:none; }
#balloon{
  position:absolute; left:92px; top:56px; width:204px; z-index:22;
  background:#ffffe1; border:1px solid #000; padding:8px 10px;
  box-shadow:2px 2px 0 rgba(0,0,0,.3);
}
#balloon::before{
  content:""; position:absolute; top:-8px; left:6px;
  border:7px solid transparent; border-bottom:8px solid #000; border-top:0;
}
#balloon::after{
  content:""; position:absolute; top:-6px; left:7px;
  border:6px solid transparent; border-bottom:7px solid #ffffe1; border-top:0;
}

/* ---------------- dialog ---------------- */
#dialog{
  position:fixed; left:50%; top:44%; transform:translate(-50%,-50%);
  width:316px; z-index:30; background:var(--face);
  box-shadow: inset -1px -1px var(--dk), inset 1px 1px var(--hi),
              inset -2px -2px var(--sh), inset 2px 2px var(--lo),
              3px 3px 0 rgba(0,0,0,.35);
}
.dlg-title{
  display:flex; align-items:center; justify-content:space-between;
  background:linear-gradient(90deg,var(--navy),#1084d0);
  color:#fff; font-weight:bold; padding:3px 4px 3px 7px;
}
.dlg-title .btn95{ width:18px; height:16px; font-size:11px; font-weight:bold; }
.dlg-body{ display:flex; gap:12px; align-items:center; padding:14px 12px 10px; line-height:1.5; }
.dlg-ico{
  flex:0 0 auto; width:34px; height:34px; border-radius:50%;
  background:var(--navy); color:#fff; font-family:Georgia,serif; font-style:italic;
  font-weight:bold; font-size:21px; display:flex; align-items:center; justify-content:center;
  box-shadow: inset -2px -2px rgba(0,0,0,.4), inset 2px 2px rgba(255,255,255,.35);
}
.dlg-btns{ text-align:right; padding:0 10px 10px; }
#dlgOk{ min-width:76px; font-weight:bold; padding:3px 0; }
</style>
</head>
<body>

