          <path d="M10.7,3.9 25.7,12.4 M5.3,6.7 20.3,15.2 M23,14 9,6 M18.6,16.4 4.6,8"/>
          <path d="M2,12.6 16,20.6 M2,15.4 16,23.4 M9,14.4 9,26.6 M4.5,12 4.5,14.9 M13.5,16.9 13.5,19.8"/>
